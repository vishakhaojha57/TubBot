# ─────────────────────────────────────────────────────────────
# frontend/.env — Development environment variables
# ─────────────────────────────────────────────────────────────
# Vite exposes any variable prefixed with VITE_ to the client.
# This file is loaded automatically when running `npm run dev`.
# ─────────────────────────────────────────────────────────────

VITE_API_BASE_URL=http://127.0.0.1:8000
